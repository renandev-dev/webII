generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  PROFESSOR
  ADMIN
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  foto      String?
  papel     Papel    @default(PROFESSOR)
  createdAt DateTime @default(now()) @map("data_criacao")
  updatedAt DateTime @updatedAt @map("data_atualizacao")

  questoes Questao[]

  @@map("users")
}

model Materia {
  id        Int       @id @default(autoincrement())
  nome      String
  descricao String?

  questoes Questao[]

  createdAt DateTime @default(now()) @map("data_criacao")
  updatedAt DateTime @updatedAt @map("data_atualizacao")

  @@map("materias")
}

model Questao {
  id          Int         @id @default(autoincrement())
  enunciado   String
  dificuldade Dificuldade

  materiaId   Int
  autorId     Int

  materia     Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  autor       User    @relation(fields: [autorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("data_criacao")
  updatedAt DateTime @updatedAt @map("data_atualizacao")

  @@map("questoes")
}